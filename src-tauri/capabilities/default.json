{
  "identifier": "default",
  "description": "Default capability for Caui desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  }
}
