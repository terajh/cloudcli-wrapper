{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Express API Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "server"],
      "port": 5888
    },
    {
      "name": "Vite Dev Server (React UI)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "client"],
      "port": 5173
    },
    {
      "name": "Full Dev (Express + Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev"],
      "port": 5173
    }
  ]
}
